{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AZURE_SUBSCRIPTION_ID": "<your subscription id>",
    "LABS_RESOURCE_GROUP": "rg-ai-workboard-labs",
    "DEFAULT_LEARNER_OBJECT_ID": "<your Azure AD object id, until real login exists>",
    "SPEECH_KEY": "<azure-speech-key>",
    "SPEECH_REGION": "<e.g. eastus>",
    "FISH_AUDIO_API_KEY": "<fish audio key, for cloning the learner's own voice>",
    "FISH_VOICE_ID": "<optional: default team voice model id, used when a learner hasn't recorded their own>",
    "CERT_VERIFY_BASE_URL": "http://localhost:5173"
  },
  "Host": {
    "CORS": "*"
  }
}
