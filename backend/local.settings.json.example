{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AZURE_SUBSCRIPTION_ID": "<your subscription id>",
    "LABS_RESOURCE_GROUP": "rg-ai-workboard-labs",
    "DEFAULT_LEARNER_OBJECT_ID": "<your Azure AD object id, until real login exists>",
    "FISH_AUDIO_API_KEY": "<fish audio key - the only TTS/voice-clone provider now (Azure TTS was removed)>",
    "FISH_VOICE_MALE": "<optional: overrides the built-in Fish Audio male default voice id (Leo)>",
    "FISH_VOICE_FEMALE": "<optional: overrides the built-in Fish Audio female default voice id (Ava)>"
  }
}
