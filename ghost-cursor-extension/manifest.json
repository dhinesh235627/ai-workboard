{
  "manifest_version": 3,
  "name": "AI Workboard Ghost Cursor",
  "version": "0.4.0",
  "description": "Guides you click by click, and talks you through it, while you create an agent in the Azure portal and the Foundry portal. Only active after you press \"Start guided session\". Reads nothing from the portals; the only thing it sends is the guide's own sentences, to the AI Workboard voice service.",
  "content_scripts": [
    {
      "matches": [
        "https://portal.azure.com/*",
        "https://ai.azure.com/*"
      ],
      "js": [
        "steps.js",
        "voice.js",
        "guide-core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "https://ai-workboard-qa.azurewebsites.net/*",
        "https://ai-workboard.azurewebsites.net/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://ai-workboard-api-qa.azurewebsites.net/*",
    "https://ai-workboard-api.azurewebsites.net/*",
    "http://localhost:5173/*",
    "http://localhost:7071/*"
  ],
  "permissions": [
    "storage",
    "offscreen"
  ]
}
